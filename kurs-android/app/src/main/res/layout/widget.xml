<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="КУРС · ПЛАН НА НЕДЕЛЮ"
        android:textStyle="bold"
        android:textSize="19sp"
        android:textColor="#23392E" />

    <TextView android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:text="Неделя"
        android:textSize="14sp"
        android:textColor="#607365" />

    <TextView android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingBottom="4dp"
        android:text="Выполнено: 0 из 0"
        android:textSize="15sp"
        android:textColor="#35795F" />

    <ListView android:id="@+id/taskList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Задач пока нет. Нажми «Править»."
        android:textSize="16sp"
        android:textColor="#607365" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/editBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="✎ Править"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#2E8A6B" />
        <TextView android:id="@+id/chat"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="match_parent"
            android:text="План с ChatGPT →"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:background="#2E8A6B" />
    </LinearLayout>
</LinearLayout>